<!doctype html>
<html lang="{{@site.locale}}" class="scroll-smooth">
  <head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{meta_title}}</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Orbitron:wght@400;500;700;900&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">
    {{^is "home"}}
    <link rel="stylesheet" href="{{asset "css/screen.css"}}">
    {{/is}}
    <link rel="stylesheet" href="{{asset "css/audio-player.css"}}">
    <link rel="stylesheet" href="{{asset "css/shop-btn.css"}}">
    <link rel="stylesheet" href="{{asset "css/member-btn.css"}}">

    <style>
        :root {
            {{#if @custom.audio_player_primary_color}}--h5ap-primary: {{@custom.audio_player_primary_color}};{{/if}}
            {{#if @custom.audio_player_background_color}}--h5ap-bg: {{@custom.audio_player_background_color}};{{/if}}
            {{#if @custom.audio_player_text_color}}--h5ap-text: {{@custom.audio_player_text_color}};{{/if}}
        }
    </style>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        heading: ['Orbitron', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            gold: '#FACC15', // Vibrant Gold
                            goldDark: '#CA8A04',
                            blue: '#3b82f6',
                            purple: '#a855f7',
                            pink: '#ec4899',
                            teal: '#14b8a6',
                            bg: '#0a0a0a', // Deep off-black
                            surface: '#121212', // Slightly lighter for cards
                            surfaceBorder: '#262626'
                        }
                    },
                    backgroundImage: {
                        'rainbow-gradient': 'linear-gradient(135deg, #3b82f6, #a855f7, #ec4899, #f97316, #FACC15, #14b8a6)',
                        'gold-gradient': 'linear-gradient(135deg, #FACC15, #CA8A04)',
                        'cyber-grid': 'linear-gradient(to right, #262626 1px, transparent 1px), linear-gradient(to bottom, #262626 1px, transparent 1px)'
                    },
                    animation: {
                        'pulse-slow': 'pulse 4s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                        'float': 'float 6s ease-in-out infinite',
                    },
                    keyframes: {
                        float: {
                            '0%, 100%': { transform: 'translateY(0)' },
                            '50%': { transform: 'translateY(-10px)' },
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #0a0a0a;
            color: #e5e5e5;
            overflow-x: hidden;
        }

        /* --- Custom Effects --- */
        .glass-nav {
            background: rgba(10, 10, 10, 0.65);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(250, 204, 21, 0.15);
        }

        .text-gradient-gold {
            background: linear-gradient(to bottom right, #FEF08A, #FACC15, #CA8A04);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .text-gradient-rainbow {
            background: linear-gradient(to right, #60a5fa, #c084fc, #f472b6, #fb923c, #fde047, #2dd4bf);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            background-size: 200% auto;
            animation: shine 5s linear infinite;
        }

        @keyframes shine {
            to { background-position: 200% center; }
        }

        /* Enhanced Card Styles */
        .cyber-card {
            background: rgba(18, 18, 18, 0.6);
            border: 1px solid #262626;
            backdrop-filter: blur(12px);
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            position: relative;
            overflow: hidden;
        }

        .cyber-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
            opacity: 0;
            transition: opacity 0.3s;
        }

        .cyber-card:hover {
            transform: translateY(-5px);
            border-color: rgba(250, 204, 21, 0.3);
            box-shadow: 0 10px 30px -10px rgba(250, 204, 21, 0.15);
        }

        .cyber-card:hover::before {
            opacity: 1;
        }

        /* Interactive Button Glow */
        .btn-glow-wrapper {
            position: relative;
            display: inline-flex;
        }
        
        .btn-glow-bg {
            position: absolute;
            top: -2px; left: -2px; right: -2px; bottom: -2px;
            background: linear-gradient(45deg, #FACC15, #a855f7, #3b82f6);
            border-radius: 9999px;
            z-index: -1;
            filter: blur(10px);
            opacity: 0.5;
            transition: opacity 0.3s ease;
            animation: pulse-border 3s infinite alternate;
        }

        .btn-glow-wrapper:hover .btn-glow-bg {
            opacity: 1;
            filter: blur(14px);
        }

        @keyframes pulse-border {
            0% { transform: scale(0.98); opacity: 0.4;}
            100% { transform: scale(1.02); opacity: 0.7;}
        }

        /* Scroll Reveal Utility Classes */
        .reveal {
            opacity: 0;
            transform: translateY(30px);
            transition: all 0.8s cubic-bezier(0.5, 0, 0, 1);
        }
        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }

        /* Scrollbar */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #0a0a0a; }
        ::-webkit-scrollbar-thumb { background: #262626; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #FACC15; }

        /* Canvas Background */
        #bg-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: -10;
            pointer-events: none; /* Let clicks pass through */
        }
    </style>

    {{ghost_head}}
  </head>
  <body>
    {{{body}}}

    {{> "audio-player"}}

    <script src="{{asset "js/audio-player.js"}}"></script>
    {{ghost_foot}}
  </body>
</html>
