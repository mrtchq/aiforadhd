                    <div class="flex flex-nowrap items-stretch overflow-x-auto gap-4 sm:gap-6 pt-1 pb-4 sm:pb-6 snap-x snap-mandatory scroll-smooth [&::-webkit-scrollbar]:h-1.5">
                        {{#foreach posts}}
                            <article class="group cyber-card rounded-2xl overflow-hidden flex flex-col flex-none w-[78vw] max-w-[290px] sm:w-[320px] sm:max-w-none md:w-[350px] snap-start reveal transition-all duration-300 hover:border-brand-gold/40">
                                {{#if feature_image}}
                                    <a href="{{url}}" class="block relative h-32 sm:h-44 overflow-hidden bg-black/40 flex-shrink-0">
                                        <img src="{{img_url feature_image size="m"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" loading="lazy" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
                                        <div class="absolute inset-0 bg-gradient-to-t from-brand-surface via-transparent to-transparent opacity-80"></div>
                                        {{#if primary_tag}}
                                            <span class="absolute top-2.5 left-2.5 px-2 py-0.5 bg-black/75 backdrop-blur-md border border-brand-gold/30 text-brand-gold font-mono text-[9px] uppercase tracking-wider rounded-md">
                                                {{primary_tag.name}}
                                            </span>
                                        {{/if}}
                                    </a>
                                {{else}}
                                    <a href="{{url}}" class="block relative h-32 sm:h-44 overflow-hidden bg-gradient-to-br from-brand-surface via-black to-brand-surface border-b border-brand-surfaceBorder flex-shrink-0">
                                        <div class="h-1.5 w-full bg-gradient-to-r from-brand-gold via-brand-purple to-brand-teal"></div>
                                        <div class="absolute inset-0 bg-cyber-grid bg-[size:24px_24px] opacity-10"></div>
                                        <div class="absolute inset-0 flex items-center justify-center">
                                            <div class="w-12 h-12 rounded-xl border border-brand-gold/30 bg-brand-gold/5 flex items-center justify-center text-brand-gold text-2xl shadow-[0_0_20px_rgba(250,204,21,0.15)] group-hover:scale-110 transition-transform">
                                                <i class="ph-duotone ph-broadcast"></i>
                                            </div>
                                        </div>
                                        {{#if primary_tag}}
                                            <span class="absolute top-2.5 left-2.5 px-2 py-0.5 bg-black/75 backdrop-blur-md border border-brand-gold/30 text-brand-gold font-mono text-[9px] uppercase tracking-wider rounded-md">
                                                {{primary_tag.name}}
                                            </span>
                                        {{/if}}
                                    </a>
                                {{/if}}
                                
                                <div class="p-4 sm:p-6 flex-grow flex flex-col justify-between">
                                    <div>
                                        <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-gray-400 font-mono text-[10px] uppercase tracking-wider mb-2">
                                            <time datetime="{{date format="YYYY-MM-DD"}}" class="flex items-center gap-1 text-gray-400">
                                                <i class="ph ph-calendar-blank text-brand-gold"></i>
                                                {{date format="MMM D, YYYY"}}
                                            </time>
                                            <span>•</span>
                                            <span class="flex items-center gap-1 text-gray-400">
                                                <i class="ph ph-clock"></i>
                                                {{reading_time}}
                                            </span>
                                            {{#has tag="#podcast, podcast, #audio, audio"}}
                                                <span>•</span>
                                                <span class="inline-flex items-center gap-1 text-brand-gold">
                                                    <i class="ph-fill ph-waveform"></i> Audio
                                                </span>
                                            {{/has}}
                                        </div>

                                        <h3 class="text-base sm:text-lg font-heading font-bold text-white mb-2 leading-snug group-hover:text-brand-gold transition-colors post-clamp-2" title="{{title}}">
                                            <a href="{{url}}">{{title}}</a>
                                        </h3>

                                        {{#if excerpt}}
                                            <p class="text-gray-400 text-xs sm:text-sm leading-relaxed mb-3 sm:mb-4 font-light post-clamp-2">
                                                {{excerpt words="18"}}
                                            </p>
                                        {{/if}}
                                    </div>

                                    <div class="pt-3 border-t border-brand-surfaceBorder flex items-center justify-between mt-auto">
                                        <div class="flex items-center gap-2 min-w-0">
                                            {{#if primary_author.profile_image}}
                                                <img src="{{primary_author.profile_image}}" alt="{{primary_author.name}}" class="w-5 h-5 sm:w-6 sm:h-6 rounded-full object-cover border border-brand-gold/30 flex-shrink-0">
                                            {{/if}}
                                            <span class="text-xs text-gray-400 font-sans truncate max-w-[110px] sm:max-w-[130px]">{{primary_author.name}}</span>
                                        </div>
                                        <a href="{{url}}" class="inline-flex items-center gap-1 font-mono text-[11px] sm:text-xs text-brand-gold hover:text-white transition-all group-hover:translate-x-1 duration-200 flex-shrink-0">
                                            <span>Read</span>
                                            <i class="ph-bold ph-arrow-right"></i>
                                        </a>
                                    </div>
                                </div>
                            </article>
                        {{/foreach}}
                    </div>
                {{else}}
                    {{!-- Empty state when Ghost has no published posts yet --}}
                    <div class="cyber-card rounded-2xl p-12 text-center max-w-xl mx-auto reveal">
                        <div class="w-16 h-16 rounded-2xl bg-brand-gold/10 border border-brand-gold/20 flex items-center justify-center text-3xl text-brand-gold mx-auto mb-4 shadow-[0_0_20px_rgba(250,204,21,0.15)]">
                            <i class="ph-duotone ph-broadcast"></i>
                        </div>
                        <h3 class="text-xl font-heading font-bold text-white mb-2">Nothing here yet</h3>
                        <p class="text-gray-400 text-sm mb-6 leading-relaxed">
                            No posts yet. New stories will show up here as soon as they are published.
                        </p>
                        <div class="inline-flex items-center gap-2 px-4 py-2 bg-brand-surface border border-brand-surfaceBorder rounded-lg font-mono text-xs text-gray-400">
                            <span class="w-2 h-2 rounded-full bg-brand-gold animate-pulse"></span>
                            More coming soon
                        </div>
                    </div>
                {{/if}}
            {{/get}}
