    <!-- Recent Posts Section (Ghost CMS Integration) -->
    <style>
      .post-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
    </style>
    <section id="recent-posts" class="py-14 sm:py-24 relative border-t border-brand-surfaceBorder">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 sm:mb-14 gap-4 sm:gap-6 reveal">
                <div class="max-w-2xl">
                    <div class="flex items-center gap-3 mb-3 sm:mb-4">
                        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-brand-gold/30 bg-brand-gold/5 text-brand-gold font-mono text-[10px] tracking-[0.2em] uppercase backdrop-blur-sm shadow-[0_0_15px_rgba(250,204,21,0.15)]">
                            <i class="ph-bold ph-newspaper text-brand-gold"></i>
                            Latest stories
                        </div>
                        <div class="inline-flex md:hidden items-center gap-2">
                            <span class="relative flex h-2.5 w-2.5">
                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-gold opacity-75"></span>
                                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-brand-gold"></span>
                            </span>
                            <span class="text-gray-500 font-mono text-[10px] tracking-wider uppercase">New</span>
                        </div>
                    </div>
                    <h2 class="text-3xl md:text-5xl font-heading font-bold text-white mb-2 sm:mb-4">Latest <span class="text-gradient-gold">Posts</span></h2>
                    <p class="text-sm sm:text-lg text-gray-400 font-light">Honest stories, useful ideas, and simple ways to make AI work for your ADHD brain.</p>
                </div>
                <div class="hidden md:flex items-center gap-3">
                    <span class="text-gray-500 font-mono text-xs tracking-wider uppercase">New posts</span>
                    <span class="relative flex h-3 w-3">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-gold opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-3 w-3 bg-brand-gold"></span>
                    </span>
                </div>
            </div>

            {{#get "posts" limit="6" include="tags,authors" order="published_at desc"}}
