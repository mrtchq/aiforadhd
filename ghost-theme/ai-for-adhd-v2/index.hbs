    <script>
      (function () {
        function openModal(id) {
          var m = document.getElementById(id);
          if (!m) return;
          m.classList.add('open');
          m.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
          var c = m.querySelector('.a4a-modal-close');
          if (c) c.focus();
        }
        function closeModal(m) {
          m.classList.remove('open');
          m.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        }
        document.querySelectorAll('[data-modal-target]').forEach(function (el) {
          el.addEventListener('click', function (e) {
            e.preventDefault();
            openModal(el.getAttribute('data-modal-target'));
          });
        });
        document.querySelectorAll('.a4a-modal').forEach(function (m) {
          m.addEventListener('click', function (e) {
            if (e.target === m) closeModal(m);
          });
          m.querySelector('.a4a-modal-close').addEventListener('click', function () { closeModal(m); });
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') {
            document.querySelectorAll('.a4a-modal.open').forEach(closeModal);
          }
        });
      })();
    </script>


    <script>
        // --- Mobile Menu Logic ---
        const btn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');
        const nav = document.querySelector('nav');

        btn.addEventListener('click', () => {
            menu.classList.toggle('hidden');
            const icon = btn.querySelector('i');
            if(menu.classList.contains('hidden')) {
                icon.className = 'ph ph-list text-3xl';
            } else {
                icon.className = 'ph ph-x text-3xl';
            }
        });

        menu.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', () => {
                menu.classList.add('hidden');
                btn.querySelector('i').className = 'ph ph-list text-3xl';
            });
        });

        // --- Member Auth Button State Sync (Sign In / Account) ---
        (function syncMemberAuthNav() {
            function applyAuthState(isSignedIn) {
                var desktopBtn = document.querySelector('[data-auth-nav="desktop"]');
                if (desktopBtn) {
                    desktopBtn.setAttribute('href', isSignedIn ? '#/portal/account' : '#/portal/signin');
                    desktopBtn.setAttribute('data-portal', isSignedIn ? 'account' : 'signin');
                    var label = desktopBtn.querySelector('[data-auth-label]');
                    if (label) label.textContent = isSignedIn ? 'Account' : 'Sign In';
                    var icon = desktopBtn.querySelector('[data-auth-icon]');
                    if (icon) icon.className = isSignedIn ? 'ph-bold ph-user-circle' : 'ph-bold ph-sign-in';
                }
                var mobileBtn = document.querySelector('[data-auth-nav="mobile"]');
                if (mobileBtn) {
                    mobileBtn.setAttribute('href', isSignedIn ? '#/portal/account' : '#/portal/signin');
                    mobileBtn.setAttribute('data-portal', isSignedIn ? 'account' : 'signin');
                    mobileBtn.textContent = isSignedIn ? 'Account' : 'Sign In';
                }
            }
            function checkSession() {
                fetch('/members/api/member/', { credentials: 'same-origin', cache: 'no-store' })
                    .then(function(res) {
                        if (res.status === 200) applyAuthState(true);
                        else if (res.status === 204 || res.status === 401) applyAuthState(false);
                    })
                    .catch(function() {});
            }
            checkSession();
            window.addEventListener('hashchange', function() { setTimeout(checkSession, 400); });
            window.addEventListener('focus', checkSession);
        })();

        // --- Navbar Scroll Effect ---
        window.addEventListener('scroll', () => {
            if (window.scrollY > 20) {
                nav.style.background = 'rgba(10, 10, 10, 0.85)';
                nav.style.borderBottomColor = 'rgba(250, 204, 21, 0.3)';
            } else {
                nav.style.background = 'rgba(10, 10, 10, 0.65)';
                nav.style.borderBottomColor = 'rgba(250, 204, 21, 0.15)';
            }
        });

        // --- Scroll Reveal Animation ---
        function reveal() {
            var reveals = document.querySelectorAll(".reveal");
            for (var i = 0; i < reveals.length; i++) {
                var windowHeight = window.innerHeight;
                var elementTop = reveals[i].getBoundingClientRect().top;
                var elementVisible = 100; // how many pixels before element is visible

                if (elementTop < windowHeight - elementVisible) {
                    reveals[i].classList.add("active");
                }
            }
        }
        window.addEventListener("scroll", reveal);
        // Trigger once on load
        reveal();


        // --- mrtc.me Animated Background (ported from the mrtc.me deck) ---
        (function(){
            var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            var $ = function(id){ return document.getElementById(id); };
            var clamp = function(v,a,b){ return Math.max(a, Math.min(b, v)); };

            /* Twinkling starfields: box-shadow star points, drifting upward */
            function genStars(n, maxCoord, palette){
                var out = [];
                for (var i = 0; i < n; i++){
                    out.push(Math.floor(Math.random() * maxCoord) + 'px ' + Math.floor(Math.random() * maxCoord) + 'px ' + palette[Math.floor(Math.random() * palette.length)]);
                }
                return out.join(', ');
            }
            function initStarfields(){
                var s1 = $('stars'), s2 = $('stars2'), s3 = $('stars3');
                if (!s1 || !s2 || !s3) return;
                var small = genStars(420, 2000, ['#ffffff','#fff9c4','#ffd54f']);
                var med = genStars(130, 2000, ['#ffffff','#ffd159','#00e5ff','#ec4899']);
                var big = genStars(55, 2000, ['#ffd159','#f5b82e','#9333ea','#ec4899','#00e5ff','#10b981']);
                s1.style.boxShadow = small; s2.style.boxShadow = med; s3.style.boxShadow = big;
                var st = document.createElement('style');
                st.textContent = '#stars:after{box-shadow:' + small + '}#stars2:after{box-shadow:' + med + '}#stars3:after{box-shadow:' + big + '}';
                document.head.appendChild(st);
            }

            /* Neural synapse canvas: drifting brand-colored nodes, connecting lines, travelling pulses */
            var canvas, ctx, raf = null;
            var nodes = [], pulses = [], ripples = [];
            var DPR = Math.min(window.devicePixelRatio || 1, 2);
            var brandColors = [
                { r:255, g:209, b:89,  hex:'#ffd159' },
                { r:0,   g:229, b:255, hex:'#00e5ff' },
                { r:236, g:72,  b:153, hex:'#ec4899' },
                { r:168, g:85,  b:247, hex:'#a855f7' },
                { r:16,  g:185, b:129, hex:'#10b981' },
                { r:249, g:115, b:22,  hex:'#f97316' }
            ];

            function sizeCanvas(){
                var w = window.innerWidth, h = window.innerHeight;
                canvas.width = Math.floor(w * DPR);
                canvas.height = Math.floor(h * DPR);
                canvas.style.width = w + 'px';
                canvas.style.height = h + 'px';
                ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
            }

            function paintFrame(){
                if (!ctx) return;
                var W = window.innerWidth, H = window.innerHeight;
                ctx.clearRect(0, 0, W, H);

                for (var r = ripples.length - 1; r >= 0; r--){
                    var rip = ripples[r];
                    rip.radius += 5.5; rip.opacity -= 0.024;
                    if (rip.opacity <= 0 || rip.radius >= rip.maxRadius){ ripples.splice(r, 1); continue; }
                    ctx.beginPath();
                    ctx.arc(rip.x, rip.y, rip.radius, 0, Math.PI * 2);
                    ctx.strokeStyle = 'rgba(' + rip.color.r + ',' + rip.color.g + ',' + rip.color.b + ',' + rip.opacity + ')';
                    ctx.lineWidth = 2;
                    ctx.stroke();
                }

                var connectDist = 130;
                for (var i = 0; i < nodes.length; i++){
                    var pt = nodes[i];
                    pt.x += pt.vx; pt.y += pt.vy; pt.phase += pt.pulseSpeed;
                    if (pt.x < 0 || pt.x > W) pt.vx *= -1;
                    if (pt.y < 0 || pt.y > H) pt.vy *= -1;

                    for (var j = i + 1; j < nodes.length; j++){
                        var p2 = nodes[j];
                        var dx = p2.x - pt.x, dy = p2.y - pt.y;
                        var dist = Math.sqrt(dx * dx + dy * dy);
                        if (dist < connectDist){
                            var alpha = (1 - dist / connectDist) * 0.3;
                            ctx.beginPath();
                            ctx.moveTo(pt.x, pt.y); ctx.lineTo(p2.x, p2.y);
                            ctx.strokeStyle = 'rgba(' + pt.color.r + ',' + pt.color.g + ',' + pt.color.b + ',' + alpha + ')';
                            ctx.lineWidth = 0.8;
                            ctx.stroke();
                            if (Math.random() < 0.002 && pulses.length < 12)
                                pulses.push({ from: pt, to: p2, progress: 0, speed: 0.04 });
                        }
                    }
                    var pulse = 1 + Math.sin(pt.phase) * 0.3;
                    ctx.beginPath();
                    ctx.arc(pt.x, pt.y, pt.radius * pulse, 0, Math.PI * 2);
                    ctx.fillStyle = pt.color.hex;
                    ctx.fill();
                }

                for (var a = pulses.length - 1; a >= 0; a--){
                    var ap = pulses[a];
                    ap.progress += ap.speed;
                    if (ap.progress >= 1){ pulses.splice(a, 1); continue; }
                    var curX = ap.from.x + (ap.to.x - ap.from.x) * ap.progress;
                    var curY = ap.from.y + (ap.to.y - ap.from.y) * ap.progress;
                    ctx.beginPath();
                    ctx.arc(curX, curY, 2.2, 0, Math.PI * 2);
                    ctx.fillStyle = '#ffffff';
                    ctx.fill();
                }
            }

            function loop(){ paintFrame(); raf = requestAnimationFrame(loop); }
            function start(){ if (raf !== null || !ctx || document.hidden) return; raf = requestAnimationFrame(loop); }
            function stop(staticPaint){
                if (raf !== null){ cancelAnimationFrame(raf); raf = null; }
                if (staticPaint) paintFrame();
            }

            function init(){
                canvas = $('neuralCanvas');
                if (!canvas) return;
                ctx = canvas.getContext('2d');
                if (!ctx) return;
                sizeCanvas();
                var rszT;
                window.addEventListener('resize', function(){
                    clearTimeout(rszT);
                    rszT = setTimeout(function(){ sizeCanvas(); if (reduced) paintFrame(); }, 200);
                });
                var count = clamp(Math.floor((window.innerWidth * window.innerHeight) / 22000), 16, 58);
                nodes = [];
                for (var k = 0; k < count; k++){
                    nodes.push({
                        x: Math.random() * window.innerWidth,
                        y: Math.random() * window.innerHeight,
                        vx: (Math.random() - 0.5) * 0.7,
                        vy: (Math.random() - 0.5) * 0.7,
                        radius: Math.random() * 2 + 1.2,
                        color: brandColors[Math.floor(Math.random() * brandColors.length)],
                        phase: Math.random() * Math.PI * 2,
                        pulseSpeed: 0.02 + Math.random() * 0.03
                    });
                }
                if (!reduced){
                    var layers = $('bgLayers');
                    window.addEventListener('pointermove', function(e){
                        if (!layers) return;
                        var px = -((e.clientX / window.innerWidth) * 2 - 1) * 8;
                        var py = -((e.clientY / window.innerHeight) * 2 - 1) * 6;
                        layers.style.transform = 'translate3d(' + px.toFixed(2) + 'px,' + py.toFixed(2) + 'px,0)';
                    }, { passive: true });
                    window.addEventListener('click', function(e){
                        ripples.push({ x: e.clientX, y: e.clientY, radius: 5, maxRadius: 190, opacity: 0.75,
                            color: { r: 255, g: 209, b: 89 } });
                    }, { passive: true });
                    document.addEventListener('visibilitychange', function(){
                        if (document.hidden) stop(false); else start();
                    });
                }
            }

            initStarfields();
            init();
            if (reduced) paintFrame(); else start();
        })();

    </script>
