{{!< default}}

<!-- mrtc.me animated background (ported from the mrtc.me deck: nebula wash + twinkling starfields + neural synapse canvas) -->
<div id="bgLayers" aria-hidden="true">
  <div class="nebula-glow"></div>
  <div class="nebula-tint"></div>
  <div id="stars"></div>
  <div id="stars2"></div>
  <div id="stars3"></div>
</div>
<canvas id="neuralCanvas" aria-hidden="true"></canvas>
<style>
  /* mrtc.me animated background */
  #bgLayers{ position:fixed; inset:0; overflow:hidden; pointer-events:none; z-index:-2; will-change:transform; }
  #bgLayers .nebula-glow{ position:absolute; inset:-10%; pointer-events:none;
    background:
      radial-gradient(circle at 15% 40%, rgba(245, 184, 46, 0.16) 0%, transparent 48%),
      radial-gradient(circle at 85% 30%, rgba(147, 51, 234, 0.18) 0%, transparent 45%),
      radial-gradient(circle at 88% 70%, rgba(236, 72, 153, 0.16) 0%, transparent 50%),
      radial-gradient(circle at 75% 85%, rgba(16, 185, 129, 0.14) 0%, transparent 45%),
      radial-gradient(ellipse at 50% 100%, rgba(255, 209, 89, 0.2) 0%, transparent 60%); }
  #bgLayers .nebula-tint{ position:absolute; inset:-10%; pointer-events:none;
    background:radial-gradient(circle at 50% 45%, rgba(255, 209, 89, 0.10) 0%, transparent 62%); }
  #stars,#stars2,#stars3{ position:absolute; top:0; left:0; background:transparent; will-change:transform; }
  #stars{ width:1px; height:1px; animation:animStar 50s linear infinite; }
  #stars2{ width:2px; height:2px; animation:animStar 95s linear infinite; }
  #stars3{ width:3px; height:3px; animation:animStar 140s linear infinite; }
  #stars:after,#stars2:after,#stars3:after{ content:" "; position:absolute; top:2000px; background:transparent; }
  #stars:after{ width:1px; height:1px; }
  #stars2:after{ width:2px; height:2px; }
  #stars3:after{ width:3px; height:3px; }
  @keyframes animStar{ from{ transform:translateY(0); } to{ transform:translateY(-2000px); } }
  #neuralCanvas{ position:fixed; inset:0; z-index:-1; pointer-events:none; will-change:transform; }
  @media (prefers-reduced-motion: reduce){ #stars,#stars2,#stars3{ animation:none; } }
  .adhd-upgrades-row > .cyber-card,.adhd-skills-row > a { flex: 0 0 min(84vw, 340px); min-width:0; scroll-snap-align:start; }
  @media (min-width:768px){ .adhd-upgrades-row > .cyber-card,.adhd-skills-row > a { flex-basis:320px; } }
  .adhd-upgrades-row,.adhd-skills-row { scrollbar-width:thin; scrollbar-color:rgba(255,209,89,.45) rgba(255,255,255,.06); }
  @media (prefers-reduced-motion: reduce){ .adhd-upgrades-row,.adhd-skills-row { scroll-behavior:auto; } }
</style>

