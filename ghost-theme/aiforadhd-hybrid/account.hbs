<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Member Portal - {{@site.title}}</title>
    <!-- Include Tailwind CSS for rapid styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Include FontAwesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts for typography matching reference -->
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'neon-gold': '#facc15',
                        'neon-purple': '#a855f7',
                        'neon-blue': '#3b82f6',
                        'neon-green': '#22c55e',
                        'dark-bg': '#0f0f13',
                        'panel-bg': '#1a1a24',
                    },
                    fontFamily: {
                        'orbitron': ['Orbitron', 'sans-serif'],
                        'inter': ['Inter', 'sans-serif'],
                    },
                    backgroundImage: {
                        'gradient-radial': 'radial-gradient(var(--tw-gradient-stops))',
                        'ai-gradient': 'linear-gradient(to right, #facc15, #22c55e, #a855f7)',
                    },
                    animation: {
                        'pulse-slow': 'pulse 4s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                        'float': 'float 6s ease-in-out infinite',
                        'glow': 'glow 2s ease-in-out infinite alternate',
                        'slide-up': 'slideUp 0.6s ease-out forwards',
                        'fade-in': 'fadeIn 0.8s ease-out forwards',
                    },
                    keyframes: {
                        float: {
                            '0%, 100%': { transform: 'translateY(0)' },
                            '50%': { transform: 'translateY(-10px)' },
                        },
                        glow: {
                            '0%': { boxShadow: '0 0 5px #facc15, 0 0 10px #facc15' },
                            '100%': { boxShadow: '0 0 10px #facc15, 0 0 20px #facc15' },
                        },
                        slideUp: {
                            '0%': { opacity: 0, transform: 'translateY(20px)' },
                            '100%': { opacity: 1, transform: 'translateY(0)' },
                        },
                        fadeIn: {
                            '0%': { opacity: 0 },
                            '100%': { opacity: 1 },
                        }
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #0f0f13;
            color: #ffffff;
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
        }

        /* Particle canvas styling */
        #particle-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            pointer-events: none;
        }

        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0f0f13;
        }
        ::-webkit-scrollbar-thumb {
            background: #333;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #a855f7;
        }

        .text-glow {
            text-shadow: 0 0 10px currentColor;
        }

        /* Premium button styling */
        .btn-premium {
            position: relative;
            overflow: hidden;
            transition: all 0.3s ease;
            z-index: 1;
        }
        .btn-premium::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
            transition: all 0.5s ease;
            z-index: -1;
        }
        .btn-premium:hover::before {
            left: 100%;
        }
        .btn-premium:hover {
            transform: translateY(-2px);
            box-shadow: 0 0 15px rgba(250, 204, 21, 0.4);
        }
        
        .btn-secondary {
             transition: all 0.3s ease;
        }
        .btn-secondary:hover {
             border-color: #a855f7;
             box-shadow: 0 0 10px rgba(168, 85, 247, 0.3);
             background-color: rgba(168, 85, 247, 0.05);
        }

        /* Glassmorphism panel styling */
        .glass-panel {
            background: rgba(26, 26, 36, 0.6);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.05);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
        }
        
        /* Subtle gradient borders for cards */
        .gradient-border-card {
            position: relative;
            border-radius: 0.75rem;
            background: #1a1a24;
            background-clip: padding-box;
            border: 1px solid transparent;
        }
        .gradient-border-card::before {
            content: '';
            position: absolute;
            top: 0; right: 0; bottom: 0; left: 0;
            z-index: -1;
            margin: -1px;
            border-radius: inherit;
            background: linear-gradient(to bottom right, rgba(250, 204, 21, 0.3), rgba(168, 85, 247, 0.1), transparent);
        }
        
        /* Animation delays */
        .delay-100 { animation-delay: 100ms; }
        .delay-200 { animation-delay: 200ms; }
        .delay-300 { animation-delay: 300ms; }
        .delay-400 { animation-delay: 400ms; }
        .delay-500 { animation-delay: 500ms; }
    </style>

    {{ghost_head}}
</head>
<body class="antialiased min-h-screen relative">

    <!-- Canvas for Particle Background -->
    <canvas id="particle-canvas"></canvas>

    <!-- Ambient Glows -->
    <div class="fixed top-0 left-1/4 w-96 h-96 bg-neon-purple rounded-full mix-blend-screen filter blur-[120px] opacity-10 animate-pulse-slow z-[-1]"></div>
    <div class="fixed bottom-0 right-1/4 w-[500px] h-[500px] bg-neon-blue rounded-full mix-blend-screen filter blur-[150px] opacity-10 animate-pulse-slow z-[-1]" style="animation-delay: 2s;"></div>
    <div class="fixed top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-80 h-80 bg-neon-gold rounded-full mix-blend-screen filter blur-[100px] opacity-[0.05] z-[-1]"></div>

    <!-- Header/Navigation -->
    <header class="w-full p-6 flex justify-between items-center relative z-10 animate-fade-in">
        <!-- Logo Area -->
        <a href="{{@site.url}}" class="flex items-center gap-3 group cursor-pointer">
            <div class="w-10 h-10 rounded-full border border-gray-700 flex items-center justify-center overflow-hidden bg-black relative group-hover:border-neon-gold transition-colors duration-300">
                {{#if @site.logo}}
                    <img src="{{@site.logo}}" alt="{{@site.title}}" class="w-6 h-6 object-contain" />
                {{else}}
                    <i class="fa-solid fa-brain text-xl text-transparent bg-clip-text bg-gradient-to-r from-neon-gold to-neon-purple"></i>
                {{/if}}
                <div class="absolute inset-0 bg-neon-gold opacity-0 group-hover:opacity-10 transition-opacity duration-300"></div>
            </div>
            <div class="flex flex-col">
                 <span class="font-orbitron font-bold text-sm tracking-widest text-white leading-tight">AI FOR</span>
                 <span class="font-orbitron font-black text-lg tracking-widest text-transparent bg-clip-text bg-gradient-to-r from-neon-blue via-neon-green to-neon-purple leading-none">ADHD</span>
            </div>
        </a>

        <!-- User Controls -->
        <div class="flex items-center gap-4">
            {{#if @member}}
                <div class="hidden sm:flex items-center gap-3 glass-panel px-4 py-2 rounded-full border border-gray-700">
                    <div class="w-2 h-2 rounded-full bg-neon-green animate-pulse"></div>
                    <span class="text-sm font-medium text-gray-300">Neural Link Active</span>
                </div>
                
                <button data-members-signout class="flex items-center gap-2 px-4 py-2 rounded-md border border-gray-700 hover:border-neon-gold hover:text-neon-gold transition-colors duration-300 text-sm font-orbitron font-bold tracking-wider text-gray-300">
                    <i class="fa-regular fa-user"></i>
                    <span>SIGN OUT</span>
                </button>
            {{else}}
                <a href="#/portal/signin" data-portal="signin" class="btn-premium px-5 py-2 rounded-md bg-black border border-neon-gold flex items-center gap-2 text-sm font-orbitron font-bold tracking-wider text-neon-gold">
                    <i class="fa-solid fa-right-to-bracket"></i>
                    <span>SIGN IN</span>
                </a>
            {{/if}}
        </div>
    </header>

    <!-- Main Dashboard Container -->
    <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-20 relative z-10">
        
        <!-- Welcome Section -->
        <section class="text-center mb-16 opacity-0 animate-slide-up delay-100">
            <div class="inline-flex items-center justify-center gap-2 px-5 py-2 rounded-full border border-neon-gold/50 bg-neon-gold/10 text-neon-gold font-orbitron text-xs font-bold tracking-[0.2em] mb-6 shadow-[0_0_15px_rgba(250,204,21,0.15)] backdrop-blur-sm">
                <i class="fa-solid fa-microchip"></i>
                <span>SYSTEM STATUS: OPTIMAL</span>
            </div>
            
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-orbitron font-bold mb-4 tracking-wide text-white">
                Welcome back, <span class="text-transparent bg-clip-text bg-gradient-to-r from-neon-gold to-neon-purple text-glow">
                    {{#if @member.firstname}}
                        {{@member.firstname}}
                    {{else}}
                        {{#if @member.name}}
                            {{@member.name}}
                        {{else}}
                            Commander
                        {{/if}}
                    {{/if}}
                </span>
            </h1>
            <p class="text-gray-400 text-lg md:text-xl max-w-2xl mx-auto font-light">
                Your neural operating system is ready. Select a protocol to continue engineering your mind.
            </p>
        </section>

        <!-- Primary Actions Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
            
            <!-- Terminal Access (Main Action) -->
            <div class="glass-panel p-8 rounded-2xl flex flex-col items-center justify-center text-center opacity-0 animate-slide-up delay-200 group relative overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-br from-neon-gold/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                
                <div class="w-20 h-20 rounded-full bg-black border border-gray-700 flex items-center justify-center mb-6 group-hover:border-neon-gold transition-colors duration-500 shadow-[0_0_30px_rgba(0,0,0,0.5)]">
                    <i class="fa-solid fa-terminal text-3xl text-neon-gold group-hover:animate-pulse"></i>
                </div>
                <h2 class="text-2xl font-orbitron font-bold text-white mb-3">Access Terminal</h2>
                <p class="text-gray-400 text-sm mb-8 max-w-xs">Enter the core workspace to access your premium AI tools, 5-day sprint, and personalized strategies.</p>
                
                <a href="/5-day-sprint/" class="btn-premium w-full max-w-[280px] py-4 rounded-xl bg-black border border-neon-gold flex items-center justify-center gap-3 group/btn">
                    <span class="font-orbitron font-bold text-neon-gold tracking-widest text-sm">INITIALIZE TERMINAL</span>
                    <i class="fa-solid fa-arrow-right-to-bracket text-neon-gold group-hover/btn:translate-x-1 transition-transform"></i>
                </a>
            </div>

            <!-- View Protocols (Content Action) -->
            <div class="glass-panel p-8 rounded-2xl flex flex-col items-center justify-center text-center opacity-0 animate-slide-up delay-300 group relative overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-bl from-neon-purple/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

                <div class="w-20 h-20 rounded-full bg-black border border-gray-700 flex items-center justify-center mb-6 group-hover:border-neon-purple transition-colors duration-500 shadow-[0_0_30px_rgba(0,0,0,0.5)]">
                    <i class="fa-solid fa-book-journal-whills text-3xl text-gray-300 group-hover:text-neon-purple transition-colors"></i>
                </div>
                <h2 class="text-2xl font-orbitron font-bold text-white mb-3">View Protocols</h2>
                <p class="text-gray-400 text-sm mb-8 max-w-xs">Browse your library of saved frameworks, past AI sessions, and unlocked prompt packs.</p>
                
                <a href="/premium-skills-prompt-packs-hub/" class="btn-secondary w-full max-w-[280px] py-4 rounded-xl bg-transparent border border-gray-600 flex items-center justify-center gap-3 group/btn">
                    <span class="font-orbitron font-bold text-gray-300 tracking-widest text-sm group-hover/btn:text-white transition-colors">ACCESS LIBRARY</span>
                    <i class="fa-solid fa-chevron-right text-gray-500 group-hover/btn:text-neon-purple group-hover/btn:translate-x-1 transition-all"></i>
                </a>
            </div>
        </div>

        <!-- Account Details & Subscription Section -->
        <section class="opacity-0 animate-slide-up delay-400">
            <div class="flex items-center gap-3 mb-6">
                <i class="fa-solid fa-shield-halved text-neon-gold"></i>
                <h3 class="font-orbitron font-bold text-xl text-white tracking-wider">ACCOUNT METRICS</h3>
                <div class="flex-grow h-px bg-gradient-to-r from-gray-700 to-transparent ml-4"></div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                
                <!-- Profile Card -->
                <div class="gradient-border-card p-6 flex items-start gap-4 hover:-translate-y-1 transition-transform duration-300">
                    <div class="w-12 h-12 rounded-full bg-gray-800 flex items-center justify-center border border-gray-600 flex-shrink-0">
                        <i class="fa-regular fa-user text-xl text-gray-400"></i>
                    </div>
                    <div>
                        <p class="text-xs text-gray-500 font-orbitron tracking-wider mb-1">OPERATOR ID</p>
                        <p class="text-white font-medium mb-1 truncate max-w-[200px]">
                            {{#if @member}}
                                {{@member.email}}
                            {{else}}
                                commander.shepard@example.com
                            {{/if}}
                        </p>
                        {{#if @member}}
                            <a href="#/portal/account" data-portal="account" class="text-sm text-neon-blue hover:text-white transition-colors flex items-center gap-1">
                                <i class="fa-solid fa-pen-to-square text-xs"></i> Edit Profile
                            </a>
                        {{else}}
                            <a href="#/portal/signin" data-portal="signin" class="text-sm text-neon-gold hover:text-white transition-colors flex items-center gap-1">
                                <i class="fa-solid fa-right-to-bracket text-xs"></i> Sign In
                            </a>
                        {{/if}}
                    </div>
                </div>

                <!-- Membership Card -->
                <div class="gradient-border-card p-6 flex items-start gap-4 hover:-translate-y-1 transition-transform duration-300">
                    <div class="w-12 h-12 rounded-full bg-gray-800 flex items-center justify-center border border-neon-gold flex-shrink-0 shadow-[0_0_10px_rgba(250,204,21,0.2)]">
                        <i class="fa-solid fa-users text-xl text-neon-gold"></i>
                    </div>
                    <div>
                        <p class="text-xs text-gray-500 font-orbitron tracking-wider mb-1">MEMBERSHIP</p>
                        {{#if @member}}
                            <div class="flex items-center gap-2 mb-1">
                                <p class="text-white font-medium">Free Community Member</p>
                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-neon-green/20 text-neon-green border border-neon-green/30">ACTIVE</span>
                            </div>
                            <p class="text-xs text-gray-400 mb-2">100% Free Access to All Tools</p>
                        {{else}}
                            <div class="flex items-center gap-2 mb-1">
                                <p class="text-white font-medium">Guest Visitor</p>
                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-gray-700 text-gray-300">UNAUTHENTICATED</span>
                            </div>
                            <p class="text-xs text-gray-400 mb-2">Free to join anytime</p>
                        {{/if}}
                        <a href="#/portal/account" data-portal="account" class="text-sm text-neon-purple hover:text-white transition-colors flex items-center gap-1">
                            <i class="fa-solid fa-user-gear text-xs"></i> Account Settings
                        </a>
                    </div>
                </div>

                <!-- Newsletter/Comms Card -->
                <div class="gradient-border-card p-6 flex items-start gap-4 hover:-translate-y-1 transition-transform duration-300">
                    <div class="w-12 h-12 rounded-full bg-gray-800 flex items-center justify-center border border-gray-600 flex-shrink-0">
                        <i class="fa-regular fa-envelope text-xl text-gray-400"></i>
                    </div>
                    <div class="w-full">
                        <p class="text-xs text-gray-500 font-orbitron tracking-wider mb-1">COMMUNICATIONS</p>
                        <p class="text-white font-medium mb-3">Signal Updates</p>
                        
                        <label class="flex items-center cursor-pointer justify-between w-full">
                            <span class="text-sm text-gray-400">Receive weekly briefings</span>
                            <div class="relative">
                                <input type="checkbox" class="sr-only" checked>
                                <div class="block bg-gray-700 w-10 h-6 rounded-full border border-gray-600 toggle-bg transition-colors duration-300"></div>
                                <div class="dot absolute left-1 top-1 bg-white w-4 h-4 rounded-full transition transform duration-300 translate-x-4 shadow-md toggle-dot"></div>
                            </div>
                        </label>
                    </div>
                </div>
                
                <style>
                    input:checked ~ .toggle-bg { background-color: #22c55e; border-color: #22c55e; box-shadow: 0 0 10px rgba(34, 197, 94, 0.4); }
                    input:checked ~ .toggle-dot { transform: translateX(100%); }
                    input:not(:checked) ~ .toggle-dot { transform: translateX(0); }
                </style>

            </div>
        </section>

    </main>

    <!-- Network Particle Script -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const canvas = document.getElementById('particle-canvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            let width, height;
            
            const particleCount = Math.min(window.innerWidth / 15, 80);
            const connectionDistance = 150;
            const mouseInteractionDistance = 200;
            const particles = [];
            
            let mouse = { x: null, y: null };

            function resize() {
                width = canvas.width = window.innerWidth;
                height = canvas.height = window.innerHeight;
            }

            class Particle {
                constructor() {
                    this.x = Math.random() * width;
                    this.y = Math.random() * height;
                    this.vx = (Math.random() - 0.5) * 0.5;
                    this.vy = (Math.random() - 0.5) * 0.5;
                    this.radius = Math.random() * 1.5 + 0.5;
                    const colors = ['rgba(59, 130, 246, 0.6)', 'rgba(168, 85, 247, 0.6)', 'rgba(250, 204, 21, 0.3)', 'rgba(255, 255, 255, 0.2)'];
                    this.color = colors[Math.floor(Math.random() * colors.length)];
                }

                update() {
                    this.x += this.vx;
                    this.y += this.vy;

                    if (this.x < 0 || this.x > width) this.vx *= -1;
                    if (this.y < 0 || this.y > height) this.vy *= -1;
                }

                draw() {
                    ctx.beginPath();
                    ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
                    ctx.fillStyle = this.color;
                    ctx.fill();
                }
            }

            function initParticles() {
                particles.length = 0;
                for (let i = 0; i < particleCount; i++) {
                    particles.push(new Particle());
                }
            }

            function drawConnections() {
                for (let i = 0; i < particles.length; i++) {
                    for (let j = i + 1; j < particles.length; j++) {
                        const dx = particles[i].x - particles[j].x;
                        const dy = particles[i].y - particles[j].y;
                        const distance = Math.sqrt(dx * dx + dy * dy);

                        if (distance < connectionDistance) {
                            ctx.beginPath();
                            ctx.moveTo(particles[i].x, particles[i].y);
                            ctx.lineTo(particles[j].x, particles[j].y);
                            const opacity = 1 - (distance / connectionDistance);
                            ctx.strokeStyle = `rgba(255, 255, 255, ${opacity * 0.1})`;
                            ctx.lineWidth = 0.5;
                            ctx.stroke();
                        }
                    }

                    if (mouse.x != null && mouse.y != null) {
                        const dx = particles[i].x - mouse.x;
                        const dy = particles[i].y - mouse.y;
                        const distance = Math.sqrt(dx * dx + dy * dy);

                        if (distance < mouseInteractionDistance) {
                            ctx.beginPath();
                            ctx.moveTo(particles[i].x, particles[i].y);
                            ctx.lineTo(mouse.x, mouse.y);
                            const opacity = 1 - (distance / mouseInteractionDistance);
                            ctx.strokeStyle = `rgba(250, 204, 21, ${opacity * 0.2})`; 
                            ctx.lineWidth = 1;
                            ctx.stroke();
                            
                            particles[i].x -= dx * 0.005;
                            particles[i].y -= dy * 0.005;
                        }
                    }
                }
            }

            function animate() {
                ctx.clearRect(0, 0, width, height);
                
                for (let i = 0; i < particles.length; i++) {
                    particles[i].update();
                    particles[i].draw();
                }
                
                drawConnections();
                requestAnimationFrame(animate);
            }

            window.addEventListener('resize', () => {
                resize();
                initParticles();
            });

            window.addEventListener('mousemove', (e) => {
                mouse.x = e.x;
                mouse.y = e.y;
            });
            
            window.addEventListener('touchmove', (e) => {
                if(e.touches.length > 0){
                    mouse.x = e.touches[0].clientX;
                    mouse.y = e.touches[0].clientY;
                }
            });

            window.addEventListener('mouseout', () => {
                mouse.x = null;
                mouse.y = null;
            });
            window.addEventListener('touchend', () => {
                mouse.x = null;
                mouse.y = null;
            });

            resize();
            initParticles();
            animate();
        });
    </script>

    {{ghost_foot}}
</body>
</html>
