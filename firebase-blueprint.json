{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information after signing in with Google",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 254 },
        "displayName": { "type": "string", "maxLength": 100 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "role": { "type": "string", "enum": ["Explorer", "Innovator", "Strategist"], "maxLength": 50 },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email", "createdAt", "lastLoginAt"]
    },
    "WaitlistEntry": {
      "title": "WaitlistEntry",
      "description": "Waitlist subscription record",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 254 },
        "role": { "type": "string", "maxLength": 50 },
        "primaryChallenge": { "type": "string", "maxLength": 100 },
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private user profile documents"
    },
    "/waitlist/{waitlistId}": {
      "schema": "WaitlistEntry",
      "description": "Waitlist submissions collection"
    }
  }
}
