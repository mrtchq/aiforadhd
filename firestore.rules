rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'email', 'createdAt', 'lastLoginAt']) &&
             data.keys().hasOnly(['userId', 'email', 'displayName', 'photoURL', 'role', 'createdAt', 'lastLoginAt']) &&
             data.userId == request.auth.uid &&
             data.email is string && data.email.size() <= 254 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             (!('role' in data) || (data.role is string && data.role.size() <= 50)) &&
             data.createdAt is timestamp &&
             data.lastLoginAt is timestamp;
    }

    function isValidWaitlistEntry(data) {
      return data.keys().hasAll(['email', 'createdAt']) &&
             data.keys().hasOnly(['email', 'role', 'primaryChallenge', 'userId', 'createdAt']) &&
             data.email is string && data.email.size() <= 254 &&
             (!('role' in data) || (data.role is string && data.role.size() <= 50)) &&
             (!('primaryChallenge' in data) || (data.primaryChallenge is string && data.primaryChallenge.size() <= 100)) &&
             (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
             data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isVerified() &&
                    isValidUserProfile(incoming()) &&
                    incoming().createdAt == request.time &&
                    incoming().lastLoginAt == request.time;
      allow update: if isOwner(userId) && isValidId(userId) && isVerified() &&
                    isValidUserProfile(incoming()) &&
                    incoming().userId == existing().userId &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().lastLoginAt == request.time &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'role', 'lastLoginAt']);
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    match /waitlist/{waitlistId} {
      allow get: if isSignedIn() && isValidId(waitlistId) && resource.data.userId == request.auth.uid;
      allow list: if false;
      allow create: if isValidId(waitlistId) && isValidWaitlistEntry(incoming()) &&
                    incoming().createdAt == request.time &&
                    (!('userId' in incoming()) || (isSignedIn() && incoming().userId == request.auth.uid));
      allow update: if false;
      allow delete: if false;
    }
  }
}
